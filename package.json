{
	"name": "luna-plugins",
	"description": "Custom plugins for Tidal Luna by SpotifyNutzer",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/SpotifyNutzeer/luna-plugins.git"
	},
	"scripts": {
		"watch": "concurrently \"pnpm:build --watch\" pnpm:serve",
		"build": "rimraf ./dist && tsx esbuild.config.ts",
		"serve": "http-server ./dist -p 3000 -s --cors -c-1"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^9.2.5",
		"http-server": "^14.1.1",
		"luna": "github:Inrixia/TidaLuna#81369c7032c9fe37d2ae37c514c355accb86377b",
		"oby": "^15.1.2",
		"rimraf": "^6.1.4",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}